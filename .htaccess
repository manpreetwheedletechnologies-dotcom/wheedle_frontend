<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect non-www to www + HTTPS
    RewriteCond %{HTTP_HOST} ^wheedletechnologies\.ai$ [NC]
    RewriteRule ^(.*)$ https://www.wheedletechnologies.ai/$1 [L,R=301]

    # Optional: force HTTPS even for www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^www\.wheedletechnologies\.ai$ [NC]
    RewriteRule ^(.*)$ https://www.wheedletechnologies.ai/$1 [L,R=301]

    # React / SPA routing
    RewriteRule ^index\.html$ - [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>